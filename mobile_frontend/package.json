{
  "name": "@docsbot/ops-mobile",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cap": "capacitor",
    "android:add": "npm run build && npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "smoke:prod": "node scripts/prod-smoke.mjs",
    "broadcast:update": "node scripts/broadcast-app-update.mjs"
  },
  "dependencies": {
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/push-notifications": "^7.0.6",
    "lucide-react": "0.487.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.7",
    "@capacitor/cli": "^7.6.7",
    "@capacitor/core": "^7.6.7",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^24.1.3",
    "tailwindcss": "4.1.12",
    "typescript": "5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
}
