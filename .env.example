DOCSBOT_PRODUCTION=false
# OpenAPI/Swagger UI. Left unset, it is ON in dev and auto-disabled when DOCSBOT_PRODUCTION=true.
# Set explicitly to true/false to override (e.g. to expose docs on a locked-down internal env).
# SPRINGDOC_ENABLED=true
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_USER_IDS=123456789,987654321
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_POLL_DELAY_MS=1000
ERP_ADMIN_USERNAME=admin
ERP_ADMIN_PASSWORD=change-this-admin-password
ERP_ADMIN_DISPLAY_NAME=Admin
# Number of trusted reverse proxies in front of the app. Rate limiting reads the client IP as
# the Nth-from-the-right X-Forwarded-For entry. 0 = don't trust the header (direct exposure);
# set 1 when behind a single nginx/Caddy proxy (the production topology) so per-client limits work
# without letting clients spoof X-Forwarded-For to bypass them.
DOCSBOT_RATE_LIMIT_TRUSTED_PROXY_HOPS=0
# Mobit-Asistan morning briefing (per-user consolidated push). Cron + zone are optional overrides.
# DOCSBOT_ASSISTANT_BRIEFING_CRON=0 30 8 * * MON-FRI
# DOCSBOT_ASSISTANT_BRIEFING_ZONE=Europe/Istanbul
# Conversational assistant answer provider: rule-based (default, zero-cost) or an LLM provider later.
# DOCSBOT_ASSISTANT_PROVIDER=rule-based
# Daily retention purge for append-only high-write tables (0 disables that table's purge).
DOCSBOT_RETENTION_ACTIVITY_EVENT_DAYS=180
DOCSBOT_RETENTION_PUSH_OUTBOX_DAYS=30
DOCSBOT_JWT_ISSUER=docsbot-ops
DOCSBOT_JWT_SECRET=replace-with-at-least-32-random-bytes
DOCSBOT_JWT_ACCESS_TOKEN_MINUTES=60
DOCSBOT_WEB_PUSH_ENABLED=false
DOCSBOT_WEB_PUSH_PUBLIC_KEY=
DOCSBOT_WEB_PUSH_PRIVATE_KEY=
DOCSBOT_WEB_PUSH_SUBJECT=mailto:admin@example.com
DOCSBOT_WEB_PUSH_TTL_SECONDS=86400
DOCSBOT_MOBILE_PUSH_ENABLED=false
DOCSBOT_FCM_PROJECT_ID=
DOCSBOT_FCM_ACCESS_TOKEN=
DOCSBOT_FCM_SERVICE_ACCOUNT_JSON=
DOCSBOT_FCM_SERVICE_ACCOUNT_PATH=
DOCSBOT_FCM_API_BASE_URL=https://fcm.googleapis.com
DOCSBOT_APNS_TEAM_ID=
DOCSBOT_APNS_KEY_ID=
DOCSBOT_APNS_BUNDLE_ID=
DOCSBOT_APNS_PRIVATE_KEY=
DOCSBOT_APNS_PRIVATE_KEY_PATH=
DOCSBOT_APNS_ENVIRONMENT=sandbox
DOCSBOT_APNS_API_BASE_URL=
DOCSBOT_MOBILE_PUSH_TIMEOUT_SECONDS=10
DOCSBOT_MOBILE_PUSH_PROCESS_DELAY_MS=15000
DOCSBOT_MOBILE_PUSH_INITIAL_DELAY_MS=10000
DOCSBOT_EMAIL_ENABLED=false
DOCSBOT_EMAIL_DRY_RUN=false
DOCSBOT_EMAIL_FROM=docsbot@example.com
DOCSBOT_EMAIL_ADMIN_TO=
DOCSBOT_EMAIL_SUBJECT_PREFIX=[DocsBot Ops]
DATABASE_URL=sqlite:///./data/db.sqlite3
DATA_DIR=../data
VAULT_DIR=../vault
MAX_FILE_SIZE_BYTES=26214400
PHONE_HASH_SALT=change-me-local-salt
JAVA_SERVER_PORT=8080
JAVA_SERVER_ADDRESS=127.0.0.1
ERP_WORKFLOW_TEMPLATE_SCAN_MS=60000
ERP_WORKFLOW_TEMPLATE_INITIAL_DELAY_MS=20000
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/docsbot
SPRING_DATASOURCE_USERNAME=docsbot
SPRING_DATASOURCE_PASSWORD=docsbot-local
